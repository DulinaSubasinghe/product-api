@startuml
class Product {
    - id : Long
    - name : String
    - price : double
}
class DigitalProduct {
    - downloadUrl : String
    - fileSizeMB : double
}
class PhysicalProduct {
    - weightKg : double
    - dimensions : String
}
Product <|-- DigitalProduct
Product <|-- PhysicalProduct
@enduml
